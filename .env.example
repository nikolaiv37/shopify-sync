# ---- Shopify credentials ----
# Your *.myshopify.com domain (no protocol, no trailing slash).
SHOPIFY_STORE_DOMAIN=mebel-center.myshopify.com

# Custom-app client credentials. The script exchanges these for a fresh
# Admin API access token at the start of every run via:
#   POST https://<shop>/admin/oauth/access_token
#   grant_type=client_credentials
# The custom app must have these Admin API scopes enabled:
#   read_products, read_inventory, read_locations, write_inventory
# For update-prices.js (variant prices) also add: write_products
# Find them in Shopify admin → Apps → <your custom app> → API credentials.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Optional: pin the Admin API version. If omitted, defaults to 2025-10.
SHOPIFY_API_VERSION=2025-10

# Optional for translation/product tooling. Leave blank if unused.
OPENROUTER_API_KEY=

# ---- Supplier feed URLs (used by feed resolution scripts) ----
# Main B2BMarkt feed (optional — falls back to local b2bmarkt_updated.xml)
B2BMARKT_MAIN_URL=

# Symetron variant of B2BMarkt feed — Greek (optional — falls back to local b2bmarkt_symetron.xml)
B2BMARKT_SYMETRON_URL=

# Symetron feed — English (act=1005&lang=2). Used by the Missing Products dashboard
# (falls back to local symetron_en.xml). Keep the feed key out of committed code.
B2BMARKT_SYMETRON_EN_URL=

# Megapap feed (optional — falls back to local megapap_en.xml)
MEGAPAP_FEED_URL=

# ---- Private operations dashboard ----
# Required for /dashboard and all dashboard API routes.
DASHBOARD_PASSWORD=replace-with-a-strong-password

# Optional: local dashboard port. Vercel ignores this.
DASHBOARD_PORT=3000

# Optional: pin the location GID where inventory is tracked.
# If omitted, the script auto-discovers the primary active location
# that fulfills online orders (your store has one: "Sofia").
# SHOPIFY_LOCATION_ID=gid://shopify/Location/104700412237

# ---- Script behaviour ----
# Directory where per-run log files are written (JSON + text).
LOG_DIR=./logs

# Inventory mutation batch size. Safe range: 10-100. Default: 50.
BATCH_SIZE=50
