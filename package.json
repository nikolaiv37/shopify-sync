{
  "name": "mebelcenter-supplier-sync",
  "version": "1.0.0",
  "description": "Sync supplier XML feeds (Megapap, B2BMarkt) to Shopify inventory, filtered by vendor.",
  "private": true,
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "node dashboardServer.js",
    "start": "node dashboardServer.js",
    "build": "node --check dashboardServer.js && node --check api/index.js && node --check lib/dashboardApp.js && node --check lib/inventorySync.js && node --check sync.js",
    "vercel-build": "npm run build",
    "sync": "node sync.js all",
    "sync:megapap": "node sync.js megapap",
    "sync:b2bmarkt": "node sync.js b2bmarkt",
    "dry-run": "node sync.js all --dry-run",
    "dry-run:megapap": "node sync.js megapap --dry-run",
    "dry-run:b2bmarkt": "node sync.js b2bmarkt --dry-run",
    "dashboard": "node dashboardServer.js",
    "prices": "node update-prices.js",
    "prices:apply": "node update-prices.js --apply",
    "prices:b2b": "node update-prices.js b2bmarkt",
    "prices:megapap": "node update-prices.js megapap",
    "export:missing": "node export-missing-products.js",
    "export:batch": "node export-missing-products.js --out-base=missing-products-batch-1 --skip=0 --limit=20",
    "translate": "python3 translate_b2bmarkt_missing.py --input missing-products.csv --out-base translated-products --model openai/gpt-4.1-mini --fallback-model openai/gpt-4o-mini --max-concurrency 1",
    "clean:csv": "python3 scripts/clean_b2bmarkt_import.py",
    "pipeline": "bash scripts/run_b2bmarkt_pipeline.sh",
    "categories:b2bmarkt": "node scripts/list_b2bmarkt_categories.js --xml=b2bmarkt_updated.xml",
    "clean:kids": "python3 scripts/clean_b2bmarkt_import.py --input shopify-kids-room-import.csv",
    "pipeline:kids": "bash scripts/run_kids_room_pipeline.sh",
    "audit:europe:not-in-feed": "node scripts/audit_europe_not_in_feed.js --xml=b2bmarkt_updated.xml"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "fast-xml-parser": "^4.5.0"
  }
}
